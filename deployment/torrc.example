# Preparation only: no service is provisioned by this file.
# Use a dedicated Tor user and protect its data directory/service private key.
# The TLS terminator at 127.0.0.1:8443 must have a valid certificate for the
# generated v3 onion hostname. Never disable certificate validation in clients.
SocksPort 0
HiddenServiceDir /var/lib/tor/whisper/
HiddenServiceVersion 3
HiddenServicePort 443 127.0.0.1:8443
