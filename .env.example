# Whisper Backend — copy to .env and adjust
# Local dev defaults are pre-filled in .env (gitignored)

# development | production
NODE_ENV=development

# HTTP port
PORT=3000

# Comma-separated allowed origins (leave empty = * in dev only — lock down in production)
# CORS_ORIGIN=https://your-app.com

# Number of trusted reverse-proxy hops. Keep 0 when Node is directly exposed.
TRUST_PROXY=0

# Maximum simultaneous sockets from one hashed network source
MAX_CONNECTIONS_PER_SOURCE=24
MAX_CONNECTIONS_GLOBAL=5000

# Rate limits for the tiny public HTTP surface (/ and /health)
HTTP_REQUESTS_PER_SOURCE=120
HTTP_REQUESTS_GLOBAL=6000

# Optional Redis for multi-instance scaling (leave empty = in-memory only)
# REDIS_URL=redis://localhost:6379
# Production Redis must have both RDB snapshots and AOF disabled. Set this only
# after verifying the provider also has no backups/replicas with persistence.
# REDIS_REQUIRE_EPHEMERAL=true
