# Whisper Backend — copy to .env and adjust
# Local dev defaults are pre-filled in .env (gitignored)

# development | production
NODE_ENV=development

# Random one-to-one chat is enabled in the current backend.
# Public groups remain disabled; ALLOW_UNVERIFIED_CHATS is obsolete.

# HTTP port
PORT=3000
BIND_HOST=127.0.0.1

# Comma-separated browser origins. Empty permits native requests without Origin only.
# CORS_ORIGIN=https://your-app.com

# Number of trusted reverse-proxy hops. Keep 0 when Node is directly exposed.
TRUST_PROXY=0
# Required when TRUST_PROXY > 0. Restrict Node access to these proxies too.
# Example for a proxy on the same host: TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUST_PROXY_CIDRS=

# Maximum simultaneous sockets from one hashed network source
MAX_CONNECTIONS_PER_SOURCE=24
# Process-wide socket cap. Global event/message/bandwidth budgets scale with it.
# Size to host RAM (budget ~50-100 KB per idle socket plus in-flight payloads)
# and raise the OS open-file limit (ulimit -n) above this value.
MAX_CONNECTIONS_GLOBAL=5000
MAX_RATE_LIMIT_BUCKETS=100000
# Remembered report/block pairs (oldest evicted when full)
MAX_BLOCKED_PAIRS=50000
# TCP accept queue for connection bursts (also capped by net.core.somaxconn)
LISTEN_BACKLOG=2048

# Rate limits for the tiny public HTTP surface (/ and /health)
HTTP_REQUESTS_PER_SOURCE=120
HTTP_REQUESTS_GLOBAL=6000

# Temporary state stays in this Node process RAM in development and production.
# Run exactly one process/replica. No external database or state service is used.
# Restarting the process ends active chats and invalidates outstanding invites.

# Join lookup lifetime (milliseconds; 1 second to 1 hour)
INVITE_TTL_MS=600000

# Phase 1: both features are opt-in. Keep disabled until coordinated validation.
ONION_ENABLED=0
ONION_SOCKET_PATH=/run/whisper-onion/relay.sock
# Total local Tor streams, pre-PROXY streams, and streams per circuit.
ONION_MAX_STREAMS=1000
ONION_MAX_PENDING=64
ONION_STREAMS_PER_CIRCUIT=8
ONION_PROXY_TIMEOUT_MS=2000
# Shared global transport cap still applies. Onion cap is additionally clamped
# to half MAX_CONNECTIONS_GLOBAL (minimum 1), preserving public admission space.
ONION_MAX_CONNECTIONS=1000
ONION_CONNECTIONS_PER_CIRCUIT=4
# Requires future mobile challenge/response integration; affects onion only.
ONION_APP_POW_ENABLED=0
ONION_APP_POW_BITS=16

# Phase 3: coordinated mobile protocol required. All incompatible features off.
RESUME_ENABLED=0
# Foreground grace only, allowed 60000..90000. Existing session TTL still applies.
RESUME_GRACE_MS=90000
BINARY_RELAY_ENABLED=0
# In-process aggregate diagnostics only; no HTTP endpoint or third-party export.
PERF_DIAGNOSTICS=0
